<div class="col-xl-5 d-none d-xl-block text-center">
<img class="hero-img img-fluid" src="https://placehold.co/400x300/dfdfdf/888888?text=400+x+300" alt="400 by 300 placeholder">
</div>
</div>
</div>
</section>

<div class="d-none mobile-options bg-light py-3">
<div class="container">
<button class="btn btn-outline-success rounded-pill w-100" type="button" data-bs-toggle="collapse" data-bs-target="#mobileAllOptions">
All options <i class="bi bi-arrow-right"></i>
</button>
<div class="collapse mt-2" id="mobileAllOptions">
<div class="list-group">
<a class="list-group-item list-group-item-action" href="#features">Home</a>
<a class="list-group-item list-group-item-action" href="#features">Pets</a>
<a class="list-group-item list-group-item-action" href="#features">Careers</a>
<a class="list-group-item list-group-item-action" href="#features">Opportunities</a>
<a class="list-group-item list-group-item-action" href="#features">Contacts</a>
</div>
</div>
</div>



<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Variant 2</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
body{background:#fff;color:#143c2d}
.navbar,.card-header{background:#198754}
.hero{background:#d5e9e1}
.stat{color:#198754;font-weight:700;font-size:1.35rem}
.stat-label{font-size:.8rem;color:#198754}
.form-card{box-shadow:0 5px 14px #0002;border-radius:12px;overflow:hidden}
.form-card .card-header{color:#fff}
.footer-strip{background:#ffc107}
.why-list .list-group-item{font-size:.94rem}
.why-list small{display:block;color:#555}
.hero-img{width:400px;height:300px;max-width:100%;object-fit:cover}
.nav-reserve{background:#ffc107;color:#222;font-size:.8rem}
.modal-content{background:#d5e9e1}
.desktop-form{order:1}
.desktop-why{order:2}
@media(max-width:1199.98px){
.hero{text-align:center}
.hero-img,.desktop-reserve,.desktop-links{display:none!important}
.desktop-why{order:1}
.desktop-form{order:2}
.form-card{margin-top:1rem}
.mobile-options{display:block!important}
.form-actions .btn{width:100%;margin-top:.45rem}
.footer-strip .row>div{margin-bottom:.6rem}
.stat-wrap{justify-content:center}
.hero .hero-copy{max-width:540px;margin:auto}
.navbar-brand{font-weight:700}
.form-card .card-body{padding:1.2rem}
}
</style>
</head>
<body>

<nav class="navbar navbar-expand-xl navbar-dark py-2">
<div class="container">
<a class="navbar-brand fw-bold" href="#">Website Name</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
<span class="navbar-toggler-icon"></span>
</button>
<div class="collapse navbar-collapse" id="mainNav">
<ul class="navbar-nav me-auto">
<li class="nav-item"><a class="nav-link active" href="#">Home</a></li>
<li class="nav-item"><a class="nav-link" href="#features">Pets</a></li>
<li class="nav-item"><a class="nav-link" href="#features">Careers</a></li>
<li class="nav-item"><a class="nav-link" href="#features">Opportunities</a></li>
<li class="nav-item"><a class="nav-link" href="#features">Contacts</a></li>
</ul>
<button class="btn btn-warning btn-sm desktop-reserve" type="button">Reserve</button>
</div>
</div>
</nav>

<section class="hero py-4 py-xl-5">
<div class="container">
<div class="row align-items-center gy-4">
<div class="col-12 col-xl-7">
<div class="hero-copy">
<h1 class="fw-bold display-6">New Heading With Style</h1>
<p class="text-secondary">
Lorem ipsum, dolor sit amet consectetur adipisicing elit.

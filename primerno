<main class="container my-4 my-xl-5" id="features">
<div class="row g-4 g-xl-5 align-items-start">

<div class="col-12 col-xl-7 desktop-form">
<div class="card form-card border-0">
<div class="card-header py-3 fw-semibold">Form Title</div>
<div class="card-body">
<form id="applicationForm">
<div class="row g-3">

<div class="col-12 col-xl-6">
<label for="firstName" class="form-label">First Name</label>
<input id="firstName" class="form-control" type="text" placeholder="Enter first name" required>
</div>

<div class="col-12 col-xl-6">
<label for="lastName" class="form-label">Last Name</label>
<input id="lastName" class="form-control" type="text" placeholder="Enter last name" required>
</div>

<div class="col-12 col-xl-6">
<label for="email" class="form-label">Email Address</label>
<div class="input-group">
<span class="input-group-text"><i class="bi bi-at"></i></span>
<input id="email" class="form-control" type="email" placeholder="name@example.com" required>
</div>
</div>

<div class="col-12 col-xl-6">
<label for="phone" class="form-label">Phone Number</label>
<div class="input-group">
<span class="input-group-text">+1</span>
<input id="phone" class="form-control" type="tel" placeholder="555 123 456">
</div>
</div>

<div class="col-12">
<label for="option" class="form-label">Select Option</label>
<select id="option" class="form-select" required>
<option value="" selected disabled>Choose an option...</option>
<option>Option One</option>
<option>Option Two</option>
<option>Option Three</option>
</select>
</div>

<div class="col-12">
<label class="form-label d-block">Select Category</label>
<div class="form-check form-check-inline">
<input class="form-check-input" type="radio" name="category" id="cat1" checked>
<label class="form-check-label" for="cat1">Option One</label>
</div>
<div class="form-check form-check-inline">
<input class="form-check-input" type="radio" name="category" id="cat2">
<label class="form-check-label" for="cat2">Option Two</label>
</div>
<div class="form-check form-check-inline">
<input class="form-check-input" type="radio" name="category" id="cat3">
<label class="form-check-label" for="cat3">Option Three</label>
</div>
</div>

<div class="col-12">
<label for="additional" class="form-label">Additional Information</label>
<textarea class="form-control" id="additional" rows="4" placeholder="Enter your comments or additional information..."></textarea>
</div>

<div class="col-12 text-xl-end form-actions">
<button type="reset" class="btn btn-outline-secondary me-xl-2">Reset</button>
<button type="submit" class="btn btn-success">Submit Form</button>
</div>

</div>
</form>
</div>
</div>
</div>

<div class="col-12 col-xl-5 desktop-why">
<h3 class="fw-bold">Why choose us?</h3>
<p class="text-secondary">Al coid is no bueno, hermano</p>

<div class="list-group why-list">
<div class="list-group-item">
<strong>Licensed title headings</strong>
<small>This text is in a list 1.</small>
</div>
<div class="list-group-item">
<strong>Licensed title headings</strong>
<small>This text is in a list 2.</small>
</div>
<div class="list-group-item">
<strong>Licensed title headings</strong>
<small>This text is in a list 3.</small>
</div>
</div>

<div class="alert alert-warning mt-4 mb-0">
<i class="bi bi-exclamation-triangle me-2"></i>
Text writing can take up to <strong>3 days</strong> before we start the lorem.
</div>
</div>

</div>
</main>

<footer class="container-fluid px-3 px-xl-4 pb-3">
<div class="footer-strip px-4 py-3">
<form id="subscribeForm" class="row g-2 align-items-center">
<div class="col-12 col-xl-2 fw-bold">
Subscribe <i class="bi bi-youtube ms-2"></i>
</div>
<div class="col-12 col-xl-4 small text-xl-end">
We post weekly every other week.
</div>
<div class="col-12 col-xl-6">
<div class="input-group">
<input type="email" class="form-control" placeholder="Email" aria-label="Email" required>
<button class="btn btn-dark" type="submit">Sign me up</button>
</div>
</div>
</form>
</div>
</footer>

<div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered">
<div class="modal-content">
<div class="modal-header border-0">
<h5 class="modal-title" id="applyModalLabel">Modal title</h5>
<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">This is the modal body!</div>
<div class="modal-footer border-0">
<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
<button type="button" class="btn btn-success" data-bs-dismiss="modal">Save changes</button>
</div>
</div>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.getElementById('applicationForm').addEventListener('submit',function(e){
e.preventDefault();
if(this.checkValidity())alert('Form submitted successfully!');
});
document.getElementById('subscribeForm').addEventListener('submit',function(e){
e.preventDefault();
if(this.checkValidity())alert('Thank you for subscribing!');
});
</script>
</body>
</html>
